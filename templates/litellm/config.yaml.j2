model_list:
  - model_name: {{ platform.default_model }}
    litellm_params:
      model: openai/{{ platform.default_model }}
      api_base: http://{{ platform.inference.host }}:{{ platform.inference.port }}/v1

general_settings:
  master_key: ${LITELLM_MASTER_KEY}
  database_url: ${LITELLM_DATABASE_URL}

litellm_settings:
  success_callback: ["langfuse"]
  failure_callback: ["langfuse"]
