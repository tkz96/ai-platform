[Unit]
Description=AI Platform llama.cpp Inference Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ platform.inference.service_user }}
WorkingDirectory={{ platform.inference.working_directory }}
ExecStart={{ platform.inference.binary_path }} \
    --host {{ platform.inference.bind_host }} \
    --port {{ platform.inference.port }} \
    --model {{ platform.inference.model_path }} \
    {{ platform.inference.extra_args | join(' ') }}
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
