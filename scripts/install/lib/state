#!/usr/bin/env bash
# State tracking for bootstrap.sh
# Manages .install-state for idempotent installs and phase-aware rollback.
# Uses jq for JSON operations — installed as a system tool.

set -euo pipefail

STATE_FILE="${PROJECT_ROOT:-.}/.install-state"

# ── State Initialization ────────────────────────────────────────────────────

state_init() {
  if [[ ! -f "$STATE_FILE" ]]; then
    cat > "$STATE_FILE" <<'EOF'
{
  "version": "0.1.0",
  "installed_at": null,
  "phases": {},
  "podman_machine": {
    "name": "ai-platform",
    "cpus": 4,
    "memory_mb": 8192,
    "disk_gb": 60
  },
  "ports": {}
}
EOF
  fi
}

# ── State Queries ───────────────────────────────────────────────────────────

state_phase_status() {
  local phase="$1"
  if [[ ! -f "$STATE_FILE" ]]; then
    echo "not_started"
    return
  fi
  local status
  status=$(jq -r ".phases.\"$phase\".status // \"not_started\"" "$STATE_FILE" 2>/dev/null || echo "not_started")
  echo "$status"
}

state_get_port() {
  local service="$1"
  local default="$2"
  if [[ ! -f "$STATE_FILE" ]]; then
    echo "$default"
    return
  fi
  jq -r ".ports.\"$service\" // $default" "$STATE_FILE" 2>/dev/null || echo "$default"
}

state_get_podman_machine() {
  local key="$1"
  local default="$2"
  if [[ ! -f "$STATE_FILE" ]]; then
    echo "$default"
    return
  fi
  jq -r ".podman_machine.\"$key\" // \"$default\"" "$STATE_FILE" 2>/dev/null || echo "$default"
}

# ── State Updates ───────────────────────────────────────────────────────────

state_set_phase() {
  local phase="$1"
  local status="$2"
  local timestamp
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  state_init

  local tmp
  tmp=$(mktemp)
  jq --arg phase "$phase" --arg status "$status" --arg ts "$timestamp" '
    .phases[$phase] = {status: $status, timestamp: $ts} |
    if ($status == "completed" and .installed_at == null) then
      .installed_at = $ts
    else
      .
    end
  ' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

state_set_port() {
  local service="$1"
  local port="$2"

  state_init

  local tmp
  tmp=$(mktemp)
  jq --arg service "$service" --argjson port "$port" '
    .ports[$service] = $port
  ' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

# ── Phase Runner ────────────────────────────────────────────────────────────

state_run_phase() {
  local phase_name="$1"
  local phase_script="$2"
  local status

  status=$(state_phase_status "$phase_name")

  if [[ "$status" == "completed" ]]; then
    ui_success "$phase_name (already completed)"
    return 0
  fi

  if [[ "$status" == "failed" ]]; then
    ui_warning "$phase_name previously failed"
    if ! ui_confirm "Retry $phase_name?"; then
      ui_error "Skipping $phase_name"
      return 1
    fi
  fi

  state_set_phase "$phase_name" "in_progress"

  if bash "$phase_script"; then
    state_set_phase "$phase_name" "completed"
    return 0
  else
    state_set_phase "$phase_name" "failed"
    return 1
  fi
}

# ── Phase-Aware Rollback ───────────────────────────────────────────────────

state_rollback() {
  local failed_phase="$1"

  ui_section "Rollback"
  ui_warning "Phase '$failed_phase' failed."

  # Phase-aware rollback: stop any services that were started
  # before the failed phase, in reverse order.
  local phases=("check-macos" "homebrew" "tools" "python" "uv" "podman" "ports" "secrets" "render" "deploy" "verify")
  local failed_index=-1

  for i in "${!phases[@]}"; do
    if [[ "${phases[$i]}" == "$failed_phase" ]]; then
      failed_index=$i
      break
    fi
  done

  # If we got past deploy, stop containers
  if (( failed_index >= 9 )); then
    ui_info "Stopping any started containers..."
    local compose_cmd
    compose_cmd=$(podman_compose_cmd 2>/dev/null || echo "podman compose")
    $compose_cmd down 2>/dev/null || true
    ui_success "Containers stopped"
  fi

  # Try to restore from backup if one exists (for update scenarios)
  local backup_dir="${PROJECT_ROOT:-.}/backups"
  local latest_backup

  if [[ -d "$backup_dir" ]]; then
    latest_backup=$(ls -t "$backup_dir"/backup_*.tar.gz 2>/dev/null | head -1)
    if [[ -n "$latest_backup" ]]; then
      ui_info "Found backup: $latest_backup"
      if ui_confirm "Restore from this backup?"; then
        tar -xzf "$latest_backup" -C "${PROJECT_ROOT:-.}"
        ui_success "Backup restored"
        return 0
      fi
    fi
  fi

  ui_info "No backup available for rollback."
  ui_info "You can fix the issue and re-run: ./bootstrap.sh"
  ui_info "Completed phases will be skipped."
  return 1
}

# ── State Reset ─────────────────────────────────────────────────────────────

state_reset() {
  if [[ -f "$STATE_FILE" ]]; then
    rm -f "$STATE_FILE"
    ui_success "Install state cleared"
  fi
}

# ── State Display ───────────────────────────────────────────────────────────

state_show() {
  if [[ ! -f "$STATE_FILE" ]]; then
    ui_info "No install state found. Run ./bootstrap.sh to install."
    return
  fi

  ui_section "Install State"
  echo "  Version:      $(jq -r '.version' "$STATE_FILE")"
  echo "  Installed at: $(jq -r '.installed_at // "never"' "$STATE_FILE")"
  echo
  echo "  Phases:"
  jq -r '.phases | to_entries[] | "    \(.value.status | select(. == "completed") | "✓") \(.key): \(.value.status)"' "$STATE_FILE" 2>/dev/null || true
  echo
  echo "  Ports:"
  jq -r '.ports | to_entries[] | "    \(.key): \(.value)"' "$STATE_FILE" 2>/dev/null || true
}